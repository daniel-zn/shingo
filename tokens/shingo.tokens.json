  "dimension": {
    "hairline": {
      "$type": "dimension",
      "$value": "1.5px"
    },
    "stripePeriod": {
      "$type": "dimension",
      "$value": "6px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "24px"
    },
    "buttonHeight": {
      "$type": "dimension",
      "$value": "48px"
    },
    "tabBarHeight": {
      "$type": "dimension",
      "$value": "60px"
    },
    "cut-s": {
      "$type": "dimension",
      "$value": "6px"
    },
    "cut-m": {
      "$type": "dimension",
      "$value": "12px"
    },
    "cut-l": {
      "$type": "dimension",
      "$value": "24px"
    }
