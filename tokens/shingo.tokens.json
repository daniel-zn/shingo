  "fontFamily": {
    "display": {
      "$type": "fontFamily",
      "$value": "Orbitron",
      "$extensions": {
        "shingo": {
          "width": "single (wide)",
          "weight": 900,
          "ios": "Orbitron-Black",
          "case": "upper",
          "use": "display wordmarks, 40 pt and up"
        }
      }
    },
    "title": {
      "$type": "fontFamily",
      "$value": "Orbitron",
      "$extensions": {
        "shingo": {
          "width": "single (wide)",
          "weight": 800,
          "ios": "Orbitron-ExtraBold",
          "case": "upper",
          "use": "titles (28), inline wordmarks (14), keycap labels"
        }
      }
    },
    "number": {
      "$type": "fontFamily",
      "$value": "Orbitron",
      "$extensions": {
        "shingo": {
          "width": "single (wide)",
          "weight": 800,
          "ios": "Orbitron-ExtraBold"
        }
      }
    },
    "cap": {
      "$type": "fontFamily",
      "$value": "Orbitron",
      "$extensions": {
        "shingo": {
          "width": "single (wide)",
          "weight": 600,
          "ios": "Orbitron-SemiBold",
          "case": "upper",
          "use": "labels, group headers, buttons, chips"
        }
      }
    },
    "body": {
      "$type": "fontFamily",
      "$value": "Anybody",
      "$extensions": {
        "shingo": {
          "width": "100%",
          "weight": 500,
          "ios": "Anybody-Medium"
        }
      }
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "IBM Plex Mono",
      "$extensions": {
        "shingo": {
          "weight": 500,
          "ios": "IBMPlexMono-Medium",
          "case": "upper",
          "use": "telemetry, metadata"
        }
      }
    },
    "stencil": {
      "$type": "fontFamily",
      "$value": "Saira Stencil One",
      "$extensions": {
        "shingo": {
          "ios": "SairaStencilOne-Regular",
          "use": "serials, stamps; once per screen"
        }
      }
    },
    "readout": {
      "$type": "fontFamily",
      "$value": "seven-segment (generated SVG / SGSegDisplay)",
      "$extensions": {
        "shingo": {
          "use": "timers, counters, hero numbers; wide cells, no ghosts"
        }
      }
    },
    "french": {
      "$type": "fontFamily",
      "$value": "Anybody Italic",
      "$extensions": {
        "shingo": {
          "weight": 500,
          "ios": "Anybody-MediumItalic",
          "use": "italic asides"
        }
      }
    },
    "japanese": {
      "$type": "fontFamily",
      "$value": "BIZ UDGothic (web)",
      "$extensions": {
        "shingo": {
          "weight": 700,
          "ios": "HiraginoSans-W6 / -W3 (system)",
          "use": "vertical captions, seals, display kanji"
        }
      }
    }
